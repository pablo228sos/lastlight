            "default": "1.0.0"
          },
          "upgrade": {
            "type": "string",
            "enum": [
              "battery_36_kwh",
              "full_precharge"
            ],
            "title": "Upgrade"
          },
          "baseline": {
            "$ref": "#/components/schemas/SimulationResult"
          },
          "upgraded": {
            "$ref": "#/components/schemas/SimulationResult"
          },
          "delta": {
            "$ref": "#/components/schemas/ComparisonDelta"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "upgrade",
          "baseline",
          "upgraded",
          "delta"
        ],
        "title": "ComparisonResult"
      },
      "ErrorBody": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code"
          },
          "message": {
            "type": "string",
            "title": "Message"
          },
          "details": {
            "items": {
              "$ref": "#/components/schemas/ErrorDetail"
