  "components": {
    "schemas": {
      "Assessment": {
        "properties": {
          "bridge_schema_version": {
            "type": "string",
            "const": "lastlight-ml-bridge-1",
            "title": "Bridge Schema Version",
            "default": "lastlight-ml-bridge-1"
          },
          "physics": {
            "$ref": "#/components/schemas/SimulationResult"
          },
          "neural": {
            "$ref": "#/components/schemas/NeuralAnalysis"
          },
          "physics_authoritative": {
            "type": "boolean",
            "const": true,
            "title": "Physics Authoritative",
            "default": true
          },
          "engineering_clearance": {
            "type": "boolean",
            "const": false,
            "title": "Engineering Clearance",
            "default": false
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "physics",
          "neural"
        ],
        "title": "Assessment"
      },
      "AssessmentRequest": {
        "properties": {
          "scenario": {
            "$ref": "#/components/schemas/SimulationRequest"
          },
          "physics_version": {
            "type": "string",
            "const": "lastlight-dispatch-1.0.0",
            "title": "Physics Version",
            "default": "lastlight-dispatch-1.0.0"
          },
          "schema_version": {
            "type": "string",
            "const": "1.0.0",
            "title": "Schema Version",
            "default": "1.0.0"
          },
          "feature_schema": {
            "type": "string",
            "enum": [
              "lastlight-official-v1-features-1",
              "lastlight-official-v1-features-2"
            ],
            "title": "Feature Schema",
            "default": "lastlight-official-v1-features-1"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "scenario"
        ],
        "title": "AssessmentRequest"
      },
      "Battery": {
        "properties": {
          "capacity_kwh": {
            "type": "number",
            "maximum": 20000.0,
            "minimum": 0.001,
            "title": "Capacity Kwh",
            "default": 24
          },
          "initial_soc": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Initial Soc",
            "default": 0.8
          },
          "minimum_soc": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Minimum Soc",
            "default": 0.2
          },
          "maximum_soc": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
