            "type": "number",
            "maximum": 1.0,
            "minimum": 0.01,
            "title": "Charge Efficiency",
            "default": 0.95
          },
          "discharge_efficiency": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.01,
            "title": "Discharge Efficiency",
            "default": 0.95
