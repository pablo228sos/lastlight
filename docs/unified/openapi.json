        "title": "CandidatePoint"
      },
      "CandidateRequest": {
        "properties": {
          "scenario": {
            "$ref": "#/components/schemas/SimulationRequest"
          },
          "physics_version": {
            "type": "string",
            "const": "lastlight-dispatch-1.0.0",
            "title": "Physics Version",
            "default": "lastlight-dispatch-1.0.0"
          },
          "schema_version": {
            "type": "string",
            "const": "1.0.0",
            "title": "Schema Version",
            "default": "1.0.0"
          },
          "feature_schema": {
            "type": "string",
            "enum": [
              "lastlight-official-v1-features-1",
              "lastlight-official-v1-features-2"
            ],
            "title": "Feature Schema",
            "default": "lastlight-official-v1-features-1"
          },
          "points": {
            "items": {
              "$ref": "#/components/schemas/CandidatePoint"
            },
            "type": "array",
            "maxItems": 1600,
            "minItems": 1,
            "title": "Points"
          },
          "limit": {
            "type": "integer",
            "maximum": 12.0,
            "minimum": 1.0,
            "title": "Limit",
            "default": 12
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "scenario",
          "points"
        ],
        "title": "CandidateRequest"
      },
      "CandidateResult": {
        "properties": {
          "bridge_schema_version": {
            "type": "string",
            "const": "lastlight-ml-bridge-1",
            "title": "Bridge Schema Version",
            "default": "lastlight-ml-bridge-1"
          },
          "physics_version": {
            "type": "string",
            "const": "lastlight-dispatch-1.0.0",
            "title": "Physics Version",
            "default": "lastlight-dispatch-1.0.0"
          },
          "schema_version": {
            "type": "string",
            "const": "1.0.0",
            "title": "Schema Version",
            "default": "1.0.0"
          },
          "neural_status": {
            "type": "string",
            "enum": [
              "available",
              "unavailable",
              "incompatible_checkpoint"
